# Provider endpoint with Robinhood Chain support (public RPC is rate-limited, not for production)
RPC_URL=https://YOUR-PROVIDER-ENDPOINT
CLICKHOUSE_PASSWORD=change-me
# Host ports for ClickHouse (unique to avoid clashing with other local services)
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_TCP_PORT=19100
RECORDER_OUT_DIR=data/feed
ENRICHER_OUT_DIR=data/blocks
ENRICHER_LOGS_OUT_DIR=data/logs
