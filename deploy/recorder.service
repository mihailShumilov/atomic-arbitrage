# hoodchain-mev: sequencer feed recorder (phase 1a).
# Install: see deploy/README.md. Paths below assume the layout from the README;
# adjust User/paths if you use a different one.

[Unit]
Description=hoodchain-mev sequencer feed recorder
Documentation=file:///opt/hoodchain-mev/deploy/README.md
Wants=network-online.target
After=network-online.target time-sync.target
# Never give up restarting (default rate limit would stop the unit after 5
# fast failures). Reconnect pacing is done inside the recorder.
StartLimitIntervalSec=0

[Service]
Type=simple
User=hood
Group=hood
WorkingDirectory=/opt/hoodchain-mev
Environment=RUST_LOG=info
# Exactly one feed connection per IP from this unit. Do not run a second
# recorder against the same IP. "Limit is 2, the 3rd gets 429" is UNVERIFIED
# (from a lost session, never reproduced); what was observed is a
# 403 + Retry-After: 3600 ban (2026-09-30), see deploy/README.md.
ExecStart=/opt/hoodchain-mev/bin/recorder --out-dir /srv/hood/data/feed

Restart=always
# 120 s between a crash and the next start. The 2026-09-30 ban followed a
# reconnect 11 s after kill -9. The recorder also enforces this itself
# (--min-connect-interval-secs 120, from connections.tsv), so a manual
# `systemctl restart` is spaced out as well. See deploy/README.md.
RestartSec=120
# SIGTERM: drain queue, close the zstd frame, fsync, write last_seq.txt.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

# Logs go to journald: journalctl -u recorder -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=recorder

# Hardening: the recorder only needs network and its output directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hood/data/feed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
