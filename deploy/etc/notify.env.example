# /etc/hoodchain/notify.env — SECRET, never commit. Owner root:hood, mode 0640.
# Without the two TELEGRAM_* values notifications go to journald only
# (journalctl -t hood-notify).
# Bot: create with @BotFather; chat id: send the bot a message, then read
# "chat":{"id":...} from https://api.telegram.org/bot<TOKEN>/getUpdates
# (do this from your Mac, not in a script on the server).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional label instead of the hostname in every message.
NOTIFY_HOST_LABEL=hood-recorder
