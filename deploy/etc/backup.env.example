# /etc/hoodchain/backup.env — backup.sh settings (sourced as shell).
# Owner root:hood, mode 0640. Credentials live in rclone.conf, not here.
# rclone remote and path, e.g. "hoodbox:hood/recorder-1" (Hetzner Storage Box
# via sftp) or "s3store:bucket/recorder-1" (S3-compatible).
BACKUP_REMOTE=CHANGE-ME:path
RCLONE_CONFIG=/etc/hoodchain/rclone.conf
#BACKUP_BWLIMIT=0
#BACKUP_MIN_AGE=65m
