# /etc/hoodchain/healthcheck.env — thresholds for healthcheck.sh (sourced as
# shell). Defaults shown; uncomment to change.
#HC_FEED_MAX_AGE_S=300          # feed silent longer than this -> alert
#HC_DISK_MAX_PCT=80             # data filesystem usage -> alert
#HC_BAN_MIN_PAUSE_S=600         # startup_wait pending_pause >= this counts as ban
#HC_MAX_CONNECTS_PER_HOUR=6     # more `connected` rows per hour -> alert
#HC_WRITER_ERROR_WINDOW_S=3600  # writer_error row in connections.tsv younger than this -> alert
#HC_GAP_ALERT_BLOCKS=2979       # new gap >= this (~5 min) -> ALERT, smaller -> INFO
#HC_BACKFILL_MAX_LAG_H=24       # unfilled gaps older than this -> alert (0 = off)
#HC_CHECK_CLOCK=1               # chrony sync check
#HC_CLOCK_MAX_OFFSET_S=0.5
#HC_BACKUP_MAX_AGE_H=0          # set to 3 after enabling backup.timer (0 = off)
#HC_CHECK_RAID=1                # md arrays in /proc/mdstat: [U_]/[_U]/inactive -> alert, resync start -> info
#HC_MDSTAT=/proc/mdstat
#HC_CHECK_SMARTD=auto           # smartd unit not active -> alert; auto = only if smartmontools is installed, 0 = off
#HC_SMARTD_UNIT=smartmontools.service
# Optional external dead-man switch (e.g. a healthchecks.io check URL): pinged
# every run, the external service alerts when pings stop. Needs Mihail's
# decision (third-party account). The URL is a secret: keep mode 0640.
#HC_HEARTBEAT_URL=
